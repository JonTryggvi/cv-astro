---
// Shared header. The CV lives on its own origin (cv.silentrecorders.io), so the
// nav links point back to the main site. Once the apps are proxied under
// jontryggvi.is/cv these can become same-origin relative links.
const HOME = 'https://jontryggvi.is';
const TETRIS = 'https://tetris.silentrecorders.io';
---

<header class="site-header">
  <a class="brand" href={HOME}>Jón Tryggvi</a>
  <nav class="nav" aria-label="Main">
    <a href={`${HOME}/web-design/`}><span class="dot" aria-hidden="true" style="background:var(--web)"></span>Web</a>
    <a href={`${HOME}/music/`}><span class="dot" aria-hidden="true" style="background:var(--music)"></span>Music</a>
    <a href={`${HOME}/photography/`}><span class="dot" aria-hidden="true" style="background:var(--photo)"></span>Photography</a>
    <a href="/" aria-current="page">CV</a>
    <a href={TETRIS}>Tetris</a>
  </nav>
</header>
